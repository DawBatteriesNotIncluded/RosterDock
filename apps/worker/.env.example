# Copy to apps/worker/.env for local development.
DATABASE_URL=postgres://rosterdock:rosterdock@localhost:5432/rosterdock
BOARD_URL=http://127.0.0.1:3000
ROSTERDOCK_WORKER_TOKEN=dev-worker-token
# Defaults to worker-<hostname>-<pid>
# ROSTERDOCK_WORKER_ID=worker-1
# The pool this worker serves: it consumes runs.<pool> instead of runs (the chart's worker.pools sets it).
# ROSTERDOCK_WORKER_POOL=secure
# How often a running run tells the board it is alive, in ms. Keep it well under the board's
# ROSTERDOCK_RUN_STALE_AFTER_MS (60 s), or the board takes the run over.
# ROSTERDOCK_HEARTBEAT_MS=15000
# A worker that starts before the board has made the queue tries this many times, this far apart.
# ROSTERDOCK_START_ATTEMPTS=60
# ROSTERDOCK_START_RETRY_MS=5000
# Serve the worker's counters on /metrics at this port; 0 serves none.
# ROSTERDOCK_WORKER_METRICS_PORT=0
# Log lines as json (the default without a terminal) or text (the default in one).
# ROSTERDOCK_LOG_FORMAT=text
# The worker's half of each run's trace goes to this OTLP collector (or to
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT as given), with these headers, under this service name.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=rosterdock-worker
# Where run workspaces live (one ephemeral directory per run). Defaults to the OS temp dir.
# ROSTERDOCK_WORK_ROOT=C:\rosterdock-runs
# Claude Code binary; on Windows the npm shim is resolved to cli.js automatically.
ROSTERDOCK_CLAUDE_BIN=claude
# The built-in tools Claude Code has at all (--tools) and the rules it uses them under without asking
# (--allowedTools): the ceiling. Bash is not on it, so a run has no shell. A department's sandbox only
# narrows it; a tool it lists that is not here (WebSearch, WebFetch) is left out of the run. WebSearch and
# WebFetch, where listed, reach the web outside the board (docs/operator.md).
ROSTERDOCK_CLAUDE_ALLOWED_TOOLS=Read(./**),Write(./**),Edit(./**),Glob(./**),Grep(./**)
# Codex binary (the npm shim is resolved on Windows too) and the widest sandbox for its commands:
# workspace-write (default), read-only, or danger-full-access for a pod that is sandboxed already. A
# department's tool list only narrows it (docs/security.md); any other value stops the worker at start.
# ROSTERDOCK_CODEX_BIN=codex
# ROSTERDOCK_CODEX_SANDBOX=workspace-write
# Comma-separated env var NAMES passed through to the engine (auth lives in ~/.claude and ~/.codex locally;
# in a cluster set ANTHROPIC_API_KEY and OPENAI_API_KEY here).
ROSTERDOCK_ENGINE_PASS_ENV=ANTHROPIC_API_KEY,CLAUDE_CODE_OAUTH_TOKEN,OPENAI_API_KEY,CODEX_API_KEY
# Git credential for https clones, resolved from the cluster secret store. Local only. The worker's git
# reads no global or system config, so your own credential helper is not used: a private repository
# needs this token.
# ROSTERDOCK_GIT_TOKEN=
# The hosts the token is sent to, comma-separated, with a port where it is not 443 (gitlab.com,
# git.example.com:8443). A repository on any other host is cloned without it. Default github.com.
# ROSTERDOCK_GIT_TOKEN_HOSTS=github.com
# Run the repository's test script after each run (the result is a review check). 0 disables; 10 min limit by
# default, inside the run's own time limit, and Stop ends them too.
# The script gets PATH, HOME, the temp directory, the locale and CI=1, never the engine's keys.
# ROSTERDOCK_RUN_REPO_TESTS=1
# ROSTERDOCK_TEST_TIMEOUT_MS=600000
# The pod's CPU and memory for the heartbeat come from the cgroup. In a pod whose engine forks beyond
# it, the chart's worker.podMetrics.enabled sets this and the worker asks the metrics API instead (it
# needs the pod's service account token and a Role; the cgroup stays behind it). Nothing to set locally.
# ROSTERDOCK_POD_METRICS=0
# With it on: the pod's namespace (the chart sets it from the downward API) and the service account token
# it presents, both read from the token's mount by default.
# ROSTERDOCK_POD_NAMESPACE=
# ROSTERDOCK_KUBERNETES_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
